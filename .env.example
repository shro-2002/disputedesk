# Copy to .env (never commit .env).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SWITCH_BASE_URL=
SWITCH_ROOM_ID=
FINOPS_LEAD=shroddha
EVIDENCE_AGENT_ID=
EVIDENCE_API_KEY=
COUNSEL_AGENT_ID=
COUNSEL_API_KEY=
GATEWAY_AGENT_ID=
GATEWAY_API_KEY=
GATEWAY_URL=http://localhost:8099
DISPUTEDESK_DB=data/disputedesk.db
# 64-hex secret keying the audit-chain HMAC. `make setup` generates one if empty. Agents/LLM never see it.
AUDIT_HMAC_KEY=
# Switch sender id of the FinOps lead (payload.sender of their message), captured at H1.
FINOPS_LEAD_SENDER_ID=
# Gateway registration key from Switch Gateway > API Keys (used once by scripts/register_agents.py).
SWITCH_REGISTRATION_KEY=
GATEWAY_RECEIPTS_DB=data/receipts.db
# Mattermost (bundled by Switch Console). Login = the account from Console > server Home >
# Messaging apps > Mattermost > Sign-in details. Used by `make h1` to create riya-support and
# post room commands as you. MATTERMOST_URL is auto-discovered by `make h1` if empty.
MATTERMOST_URL=
MM_ADMIN_LOGIN=
MM_ADMIN_PASSWORD=
RIYA_PASSWORD=
# Seeded FinOps lead Mattermost login (from server/.env via `make server-init`); used to post room commands as the lead.
MM_LEAD_LOGIN=
MM_LEAD_PASSWORD=
